#       Plugin auf file_get_contents mit Stromkontext zurueck - das
#       funktioniert, kennt aber weder eigene Kopfzeilen bei Umleitungen noch
#       eine getrennte Zeitgrenze fuer den Verbindungsaufbau.
php-curl
