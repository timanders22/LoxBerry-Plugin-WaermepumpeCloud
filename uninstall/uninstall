#!/bin/bash
# Waermepumpe Cloud - uninstall
#
# Beim Entfernen: Zugangsdaten wirklich loeschen.
#
# Sie liegen in $LBPCONFIG, und LoxBerry raeumt das mit auf - aber erst nach
# diesem Skript. Ein Zugangstoken zur Herstellercloud, das nach dem
# Deinstallieren noch auf der Karte steht, ist genau das, was niemand
# erwartet.
#
# Neu in 0.9.1: es wird nicht mehr Datei fuer Datei geloescht, sondern der
# ganze Datenordner samt Unterordnern, und dazu die Arbeitsdateien auf der
# Ramdisk. Die lagen bis 0.9.0 unberuehrt herum - die Sperrdatei, die
# Zeitstempel, die Zwischenstaende.

PFOLDER="${3:-waermepumpe}"
# Wurzel, in dieser Reihenfolge (Regeln/06: ohne brauchbare Wurzel warnen
# statt vollziehen):
#   1. das fuenfte Argument - der Installer uebergibt dort die LoxBerry-Wurzel,
#   2. $LBHOMEDIR, wenn darunter config/plugins und data/plugins liegen,
#   3. vom eigenen Ablageort aufwaerts das erste Verzeichnis mit
#      config/plugins, data/plugins UND config/system/general.json.
# Bewusst kein fest verdrahteter Systempfad und keine feste Zahl "..": je
# nachdem, wohin LoxBerry das Skript legt, sind es drei oder vier Ebenen.
#
# Bis 0.9.22 genuegten der Suche config/plugins und data/plugins. In WSL
# gemessen (Pruefung-WaermepumpeCloud-0.9.23, Fall K3): aus einem Archiv in
# einem fremden Baum mit genau diesen Ordnern, aber ohne general.json, nahm
# sie diesen Baum als Wurzel und loeschte dort die Zweitschrift. Bauart
# BatterieBMS 0.9.28; dieselbe Suche steht in den drei Hakenskripten.
wp_wurzel_suchen() {
    wp_v=$(cd "$(dirname "$(readlink -f "$0")")" 2>/dev/null && pwd -P)
    wp_i=0
    while [ -n "$wp_v" ] && [ "$wp_v" != "/" ] && [ "$wp_i" -lt 8 ]; do
        if [ -d "$wp_v/config/plugins" ] && [ -d "$wp_v/data/plugins" ] \
           && [ -f "$wp_v/config/system/general.json" ]; then
            echo "$wp_v"
            return 0
        fi
        wp_v=$(dirname "$wp_v")
        wp_i=$((wp_i + 1))
    done
    return 1
}
BASE="${5:-}"
if [ -z "$BASE" ] || [ ! -d "$BASE" ]; then
    if [ -n "${LBHOMEDIR:-}" ] && [ -d "$LBHOMEDIR/config/plugins" ] \
       && [ -d "$LBHOMEDIR/data/plugins" ]; then
        BASE="$LBHOMEDIR"
    else
        BASE=$(wp_wurzel_suchen) || BASE=""
    fi
fi
# ACHTUNG - hier lag bis 0.9.10 der schwerste Fehler dieses Plugins.
#
# $LBPCONFIG und $LBPDATA sind die Umgebungsvariablen des INSTALLERS. Sie
# zeigen auf <home>/config/plugins bzw. <home>/data/plugins, also OHNE den
# Pluginordner; LoxBerry reicht sie ueber "Defaults env_keep" in
# /etc/sudoers.d/lbdefaults an dieses Skript durch, sie SIND hier gesetzt.
#
# Bis 0.9.10 stand hier DATADIR="${LBPDATA:-...}" ohne angehaengten Ordner.
# Das rm -rf weiter unten hat damit <home>/data/plugins geloescht - also die
# Zwischenstaende, Token-Dateien und Anmeldemarken JEDES installierten
# Plugins. 2>/dev/null verschluckte jede Meldung, und das Skript meldete
# danach <OK>. Nachgestellt am 16.08.2026 in einer Attrappe: vier Plugins
# drin, vier Plugins weg.
CFGDIR="${LBPCONFIG:-$BASE/config/plugins}/$PFOLDER"
DATADIR="${LBPDATA:-$BASE/data/plugins}/$PFOLDER"

# ---------------------------------------------------------------
# 0. Fail closed - BEVOR irgendetwas geloescht wird
# ---------------------------------------------------------------
# Die Abweisung weiter unten prueft(e) den basename von DATADIR gegen
# $PFOLDER. Das kann nach der Zeile darueber gar nicht mehr abweichen: der
# Ordner wird ja genau dort angehaengt. Sie war eine Tautologie und hat
# ausgerechnet den Fall nicht gefangen, gegen den sie geschrieben war -
# eine Umgebungsvariable, die eine Ebene daneben zeigt.
#
# Nachgestellt mit LBPDATA=<home>/data statt <home>/data/plugins:
#   <home>/data/waermepumpe/wichtig/  wurde GELOESCHT   (fremder Ordner)
#   <home>/data/plugins/waermepumpe/  blieb stehen      (die eigenen Marken)
#   gemeldet wurde <OK>, Rueckgabewert 0.
#
# Geprueft wird deshalb die LAGE, nicht der letzte Pfadteil: beide Baeume
# muessen da sein, und beide Pfade muessen wirklich darunter liegen. Ein
# Loeschskript, das sich im Pfad irrt, ist schlimmer als eines, das nicht
# laeuft.
if [ -z "$BASE" ] || [ ! -d "$BASE/config/plugins" ] || [ ! -d "$BASE/data/plugins" ]; then
    echo "<FAIL> Das sieht nicht nach einem LoxBerry aus (BASE='$BASE')."
    echo "<INFO> Es wurde NICHTS geloescht. Von Hand nachsehen in"
    echo "<INFO>   <home>/config/plugins/$PFOLDER  und  <home>/data/plugins/$PFOLDER"
    exit 1
fi
if [ "$(dirname "$CFGDIR")" != "$BASE/config/plugins" ] \
   || [ "$(dirname "$DATADIR")" != "$BASE/data/plugins" ]; then
    echo "<FAIL> Die Pfade liegen nicht unter den erwarteten Baeumen:"
    echo "<FAIL>   CFGDIR  = $CFGDIR"
    echo "<FAIL>   DATADIR = $DATADIR"
    echo "<INFO> Erwartet unter $BASE/config/plugins bzw. $BASE/data/plugins."
    echo "<INFO> Es wurde NICHTS geloescht - pruefen Sie \$LBPCONFIG und \$LBPDATA."
    exit 1
fi

# ---------------------------------------------------------------
# 0b. Zurueckbehaltene MQTT-Themen der Linie leeren
# ---------------------------------------------------------------
# Seit 0.9.20 gehen Zustaende retained hinaus. Bis 0.9.22 blieben sie nach
# dem Deinstallieren im Broker stehen, und nach jedem Neustart von Broker
# oder Gateway bekam der Miniserver sie wieder (in WSL gemessen,
# Pruefung-WaermepumpeCloud-0.9.23, Fall U1: 13 von 13 standen noch). VOR dem
# Loeschen der Ordner (Praefix und bin/ sind hier noch da). Geleert wird ueber
# den Weg der Linie, den UDP-Eingang des Gateways, und beim Broker
# nachgelesen, wo er sich fragen laesst (wp_mqtt_leeren() in wp_lib.php).
# Als loxberry, nicht als root; stdin geschlossen, damit su nie auf eine
# Eingabe wartet. Bauart BatterieBMS 0.9.28.
WP_ABRUF="$BASE/bin/plugins/$PFOLDER/wp_abruf.php"
if command -v php >/dev/null 2>&1 && [ -f "$WP_ABRUF" ]; then
    if [ "$(id -u)" = "0" ] && id loxberry >/dev/null 2>&1; then
        su -s /bin/bash loxberry -c "$(printf '%q ' env "LBHOMEDIR=$BASE" "LBPPLUGINDIR=$PFOLDER" \
            timeout 60 php "$WP_ABRUF" --mqtt-leeren)" < /dev/null 2>&1 || true
    else
        env "LBHOMEDIR=$BASE" "LBPPLUGINDIR=$PFOLDER" timeout 60 php "$WP_ABRUF" --mqtt-leeren \
            < /dev/null 2>&1 || true
    fi
else
    echo "<INFO> PHP oder wp_abruf.php fehlt - zurueckbehaltene MQTT-Themen wurden nicht geleert."
fi

# ---------------------------------------------------------------
# 1. Zugangsdaten - ueberschreiben, dann entfernen
# ---------------------------------------------------------------
# Nur unlink liesse den Inhalt auf der Karte stehen, bis der Platz neu
# vergeben wird.
for f in "$CFGDIR/geheim.json" "$CFGDIR/geheim.json.vorher"; do
    if [ -f "$f" ]; then
        LAENGE=$(stat -c %s "$f" 2>/dev/null || echo 0)
        [ "$LAENGE" -gt 0 ] && dd if=/dev/zero of="$f" bs=1 count="$LAENGE" \
            conv=notrunc >/dev/null 2>&1
        rm -f "$f"
    fi
done
# Der Sicherungsordner eines abgebrochenen Upgrades - dort liegt eine Kopie
# von geheim.json. Zwei Orte, weil er mit 0.9.17 umgezogen ist:
#
#   <ordner>/.upgrade    bis 0.9.16 - IM Konfigordner, den LoxBerry ohnehin
#                        entfernt; die Zeile bleibt fuer Anlagen stehen, die
#                        von einer aelteren Fassung kommen
#   <ordner>.upgrade     ab 0.9.17 - NEBEN dem Konfigordner. Genau deshalb
#                        ueberlebt er das Abraeumen des Installers - und
#                        genau deshalb muss ER hier weg. Was neben dem
#                        Ordner liegt, raeumt LoxBerry nicht mit auf.
rm -rf "$CFGDIR/.upgrade" 2>/dev/null
RUECKFALL="$CFGDIR.upgrade"
if [ -d "$RUECKFALL" ]; then
    for f in "$RUECKFALL/geheim.json" "$RUECKFALL/waermepumpe.json"; do
        if [ -f "$f" ]; then
            LAENGE=$(stat -c %s "$f" 2>/dev/null || echo 0)
            [ "$LAENGE" -gt 0 ] && dd if=/dev/zero of="$f" bs=1 count="$LAENGE" \
                conv=notrunc >/dev/null 2>&1
        fi
    done
    rm -rf "$RUECKFALL"
fi
# .upgrade_pfad wird seit 02.09.2026 nicht mehr angelegt (der Merker konnte
# den Weg zu postupgrade.sh nie ueberleben - Begruendung in preupgrade.sh).
# Die Zeile bleibt trotzdem stehen: auf einer Anlage, die von einer aelteren
# Fassung kommt, liegt die Datei noch da, und dieses Skript ist die letzte
# Gelegenheit, sie wegzuraeumen.
rm -f "$CFGDIR/.upgrade_pfad" 2>/dev/null

# ---------------------------------------------------------------
# 1b. Die Zweitschrift NEBEN dem Konfigordner
# ---------------------------------------------------------------
# wp_config_write() legt <home>/config/plugins/<ordner>.backup.waermepumpe.json
# an - eine Ebene UEBER dem Ordner, den LoxBerry beim Deinstallieren entfernt.
# Bis 0.9.10 blieb sie deshalb liegen, und wp_config() spielte sie bei der
# naechsten Neuinstallation stillschweigend zurueck. Gemessen am 16.08.2026:
# nach Deinstallation und frischer Neuinstallation standen Hersteller, Takt UND
# das alte Aktionstoken wieder da. Eine saubere Neuinstallation war damit keine.
ZWEITSCHRIFT="$(dirname "$CFGDIR")/$PFOLDER.backup.waermepumpe.json"
# NEU 0.9.20: die Zugangsdaten haben ebenfalls eine Zweitschrift neben dem
# Ordner - und die enthaelt Kennwort und Erneuerungsmerkmal.
ZWEITSCHRIFT_G="$(dirname "$CFGDIR")/$PFOLDER.backup.geheim.json"
for ZW in "$ZWEITSCHRIFT" "$ZWEITSCHRIFT_G"; do
    if [ -f "$ZW" ]; then
        LAENGE=$(stat -c %s "$ZW" 2>/dev/null || echo 0)
        [ "$LAENGE" -gt 0 ] && dd if=/dev/zero of="$ZW" bs=1 count="$LAENGE" \
            conv=notrunc >/dev/null 2>&1
        rm -f "$ZW"
    fi
done
# Leere Altlast aus Fassungen bis 0.9.10 (flach in config/plugins).
ALT="$(dirname "$CFGDIR")/waermepumpe.json"
if [ -f "$ALT" ] && [ "$(tr -d ' \r\n\t' < "$ALT" 2>/dev/null)" = "{}" ]; then
    rm -f "$ALT"
fi

# ---------------------------------------------------------------
# 2. Datenordner vollstaendig
# ---------------------------------------------------------------
# Darin liegen die Zwischenstaende UND die erneuerbaren Anmeldemarken der
# drei Herstellerclouds (token_onecta.json, token_myuplink.json,
# token_melcloud.json). Die sind auch ohne Passwort ein gueltiger Zugang.
# Ein rm -rf, das genau dann zu weit greift, wenn eine Umgebungsvariable
# anders aussieht als erwartet, ist die teuerste Art Fehler: er faellt erst
# auf, wenn die Daten der anderen Plugins schon weg sind. Die Abweisung dagegen
# steht seit 0.9.17 als Abschnitt 0 ganz oben - vor dem ersten Loeschen und
# nicht erst vor diesem einen. Sie prueft die Lage statt des letzten
# Pfadteils; die alte Fassung an dieser Stelle konnte gar nicht anschlagen.
rm -rf "$DATADIR" 2>/dev/null
# Und was NEBEN dem Datenordner liegt, weil es ein Upgrade ueberleben muss
# (seit 0.9.23 die Tagesbudget-Listen, wp_paths()['bestand']). Der Pfad ist
# DATADIR mit angehaengtem ".bestand" - Abschnitt 0 hat DATADIR schon auf
# <wurzel>/data/plugins/<ordner> geprueft.
BESTAND="$DATADIR.bestand"
rm -rf "$BESTAND" 2>/dev/null

# ---------------------------------------------------------------
# 3. Arbeitsdateien auf der Ramdisk
# ---------------------------------------------------------------
# wp_tmpdir() zeigt auf /run/shm/<ordner>, mit Rueckfall auf den
# Systemtempordner. Dort liegen die Sperrdatei des Abrufdienstes, die
# Zeitstempel der gebremsten Meldungen, die zwischengespeicherten
# Zugriffsmerkmale und der Merker fuer den abgelaufenen Onecta-Zugang.
# Bis 0.9.22 hiess der Ordner fest "waermepumpe" - auch fuer eine
# Zweitinstallation, deren Deinstallation damit die Arbeitsdateien der ersten
# loeschte (in WSL gemessen, Pruefung-WaermepumpeCloud-0.9.23, Fall U6). Ein
# $PFOLDER mit "/" weist Abschnitt 0 ab (die Pfade laegen nicht mehr unter
# config/plugins bzw. data/plugins); ".." allein laesst rm -rf nicht zu
# (gemessen, Fall U7).
rm -rf "/run/shm/$PFOLDER" "${TMPDIR:-/tmp}/$PFOLDER" "/tmp/$PFOLDER" 2>/dev/null

# ---------------------------------------------------------------
# 4. Nachzaehlen - und nur melden, was wirklich weg ist
# ---------------------------------------------------------------
# Bis 0.9.16 stand hier ein unbedingtes <OK>. Nachgestellt an einem leeren
# Basisverzeichnis: gefunden wurde nichts, geloescht wurde nichts, gemeldet
# wurde "Zugangsdaten ... entfernt" mit Rueckgabewert 0. Ein "alles entfernt"
# nach einem fehlgeschlagenen rm ist die schlechteste Zeile einer solchen
# Datei - der Betreiber hat danach keinen Anlass mehr nachzusehen.
UEBRIG=""
for f in "$CFGDIR/geheim.json" "$CFGDIR/geheim.json.vorher" "$ZWEITSCHRIFT" \
         "$ZWEITSCHRIFT_G" "$CFGDIR/.upgrade_pfad"; do
    [ -e "$f" ] && UEBRIG="$UEBRIG $f"
done
for d in "$DATADIR" "$BESTAND" "$RUECKFALL" "$CFGDIR/.upgrade"; do
    [ -e "$d" ] && UEBRIG="$UEBRIG $d"
done

if [ -n "$UEBRIG" ]; then
    echo "<FAIL> Nicht alles liess sich entfernen. Bitte von Hand nachsehen:"
    for r in $UEBRIG; do echo "<FAIL>   $r"; done
    exit 1
fi
echo "<OK> Zugangsdaten, Anmeldemarken, Zwischenstaende und Arbeitsdateien entfernt."
echo "<INFO> Nachgezaehlt: unter $CFGDIR und $DATADIR liegt nichts mehr,"
echo "<INFO> und auch die beiden Zweitschriften daneben sind weg."
exit 0
