#!/bin/bash
# Ruft den Abrufdienst jede Minute auf. Ob tatsaechlich eine Anfrage an die
# Herstellercloud geht, entscheidet das Skript selbst: jeder Hersteller hat
# einen eigenen Mindesttakt, und Daikin hat ein hartes Tagesbudget.
#
# Ueber den Interpreter aufgerufen, nicht ueber die Raute-Zeile: geht beim
# Entpacken das Ausfuehrungsrecht verloren, laeuft der Abruf trotzdem an.
# WARUM DIE FEHLERAUSGABE NICHT MEHR NACH /dev/null GEHT
# Bis 0.9.16 stand hier ">/dev/null 2>&1". Damit war JEDE Meldung fort, die
# der Dienst nicht selbst ins Protokoll schreibt - ein "Failed opening
# required" beim Einbinden der Bibliothek etwa faellt an, BEVOR wp_log()
# ueberhaupt zur Verfuegung steht. Der Takt liefe dann Fassungen lang leer,
# ohne dass irgendwo etwas davon stuende. Dieselbe Klasse hat den
# EVCC-Abrufdienst der Fassung 0.9.8 gekostet.
#
# Die regulaere Ausgabe bleibt still - sonst schreibt der Cron jede Minute.
# Die FEHLERausgabe landet neben dem Protokoll und ist im Reiter Logdateien
# zu sehen.
mkdir -p "REPLACELBPLOGDIR" 2>/dev/null
ERR="REPLACELBPLOGDIR/cron.err"
touch "$ERR" 2>/dev/null
# 0.9.40 (Nachzug 01.11.2026, Bauart Renault NG 2.1.23): ist die Fehlerdatei nicht schreibbar, braeche die
# Umlenkung den Befehl ab, BEVOR er startet - bis 0.9.39 kein Lauf und keine Spur. Dann geht die Fehlerausgabe
# nach /dev/null, und der Lauf findet statt.
[ -f "$ERR" ] && [ -w "$ERR" ] || ERR=/dev/null
/usr/bin/php REPLACELBPBINDIR/wp_abruf.php >/dev/null 2>>"$ERR"
